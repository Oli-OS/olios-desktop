FROM docker.io/library/ubuntu:26.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    libcairo2-dev \
    libxkbcommon-dev \
    libwayland-dev \
    pkg-config \
    wayland-protocols \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY client.c background.c ./

RUN mkdir -p /tmp/oli-desktop-build /out \
    && wayland-scanner client-header \
    /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
    /tmp/oli-desktop-build/xdg-shell-client-protocol.h \
    && wayland-scanner private-code \
    /usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml \
    /tmp/oli-desktop-build/xdg-shell-protocol.c \
    && cc -std=c11 -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L \
    -I/tmp/oli-desktop-build client.c /tmp/oli-desktop-build/xdg-shell-protocol.c \
    -o /out/oli-desktop-gui-prototype $(pkg-config --cflags --libs wayland-client cairo) \
    && cc -std=c11 -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200809L \
    -I/tmp/oli-desktop-build background.c /tmp/oli-desktop-build/xdg-shell-protocol.c \
    -o /out/oli-desktop-background-prototype $(pkg-config --cflags --libs wayland-client cairo xkbcommon)

FROM docker.io/library/ubuntu:26.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    fonts-dejavu-core \
    libcairo2 \
    libxkbcommon0 \
    libseat1 \
    libwayland-client0 \
    util-linux \
    weston \
    && rm -rf /var/lib/apt/lists/* \
    && weston_help="$(weston --help 2>&1)" \
    && printf '%s' "$weston_help" | grep -q -- '--shell' \
    && find /usr/lib -type f -name kiosk-shell.so -print -quit | grep -q .

COPY --from=build /out/oli-desktop-gui-prototype /usr/local/bin/oli-desktop-gui-prototype
COPY --from=build /out/oli-desktop-background-prototype /usr/local/bin/oli-desktop-background-prototype
COPY weston.ini /etc/oli-desktop/weston-default.ini

RUN chmod 0555 /usr/local/bin/oli-desktop-gui-prototype /usr/local/bin/oli-desktop-background-prototype